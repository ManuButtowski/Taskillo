#!/bin/sh
# Plan B opcional si GitHub Actions no está disponible: ejecuta en local lo mismo que el job "api" de CI.
# NO está instalado por defecto. Para activarlo (desde la raíz del repo):
#   cp scripts/pre-push.sample .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# Necesita `docker compose up -d postgres mailpit`. Para saltarlo una vez: git push --no-verify.
set -e
cd "$(git rev-parse --show-toplevel)"
pnpm typecheck
pnpm test
