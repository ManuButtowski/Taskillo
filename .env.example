# Copia este fichero a .env y ajusta los valores. .env nunca se sube a Git.
# Los valores de ejemplo funcionan en local (Docker Compose + Mailpit).
# Lista definitiva de la spec 001 (research.md, "Variables de entorno").

# --- Servidor ---
NODE_ENV=development
PORT=3000
# URL pública de la API (enlace de recuperación de contraseña). En producción: https://<API_DOMAIN>
PUBLIC_BASE_URL=http://localhost:3000
# true solo tras un proxy de confianza (Caddy en el VPS): se lee la IP de X-Forwarded-For
TRUST_PROXY=false

# --- Base de datos (PostgreSQL 16 de Docker Compose en local; Neon en producción con ?sslmode=require) ---
DATABASE_URL=postgres://taskillo:taskillo@localhost:5432/taskillo
# Base de datos EXCLUSIVA de los tests: se vacía en cada ejecución y debe ser distinta de DATABASE_URL
TEST_DATABASE_URL=postgres://taskillo:taskillo@localhost:5432/taskillo_test

# --- Contenedor de PostgreSQL (docker-compose.yml) ---
POSTGRES_USER=taskillo
POSTGRES_PASSWORD=taskillo
POSTGRES_DB=taskillo

# --- Autenticación ---
# Mínimo 32 caracteres. Genera uno real con: openssl rand -base64 48
JWT_SECRET=valor-de-ejemplo-solo-para-local-cambialo-en-produccion

# --- Correo: smtp (IONOS o Mailpit en local) | resend ---
MAIL_DRIVER=smtp
MAIL_FROM="Taskillo <no-reply@devkomp.es>"
# En local, Mailpit: SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_SECURE=false, sin usuario
# (la interfaz web de Mailpit está en http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
# true = TLS directo (puerto 465); false = STARTTLS si el servidor lo ofrece (587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Solo si MAIL_DRIVER=resend
RESEND_API_KEY=
# Solo para tests: si se define, el test de correo envía de verdad a Mailpit
MAILPIT_URL=http://localhost:8025

# --- Despliegue en el VPS (deploy/docker-compose.prod.yml) ---
# Dominio de la API; Caddy obtiene el certificado de Let's Encrypt para él
API_DOMAIN=api.example.com
