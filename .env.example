# Copia este fichero a .env y rellena los valores reales. .env nunca se sube a Git.
# Las variables definitivas las fija la spec 001; esta es la lista prevista.

# --- Base de datos (Neon en la nube, o el PostgreSQL de Docker Compose en local) ---
DATABASE_URL=postgres://taskillo:taskillo@localhost:5432/taskillo

# --- Autenticación ---
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio

# --- Correo: smtp (IONOS o Mailpit en local) | resend ---
MAIL_PROVIDER=smtp
MAIL_FROM="Taskillo <no-reply@devkomp.es>"
# En local, Mailpit: SMTP_HOST=localhost, SMTP_PORT=1025, sin usuario ni STARTTLS
SMTP_HOST=smtp.ionos.es
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=no-reply@devkomp.es
SMTP_PASSWORD=
# Solo si MAIL_PROVIDER=resend
RESEND_API_KEY=

# --- URL pública de la API (enlaces de verificación y recuperación) ---
PUBLIC_API_URL=http://localhost:8787
