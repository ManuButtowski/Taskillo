<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: sin copia en la nube ni transferencia entre dispositivos. El perfil
     cacheado y las claves de flutter_secure_storage no deben salir del dispositivo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
