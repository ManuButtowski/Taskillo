{
  "openapi": "3.1.0",
  "info": {
    "title": "Taskillo API",
    "version": "0.1.0",
    "description": "API de Taskillo."
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "Empty": {
        "type": "object",
        "properties": {}
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "tokens": {
            "$ref": "#/components/schemas/Tokens"
          }
        },
        "required": [
          "user",
          "tokens"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "username",
          "displayName",
          "timezone"
        ]
      },
      "Tokens": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer",
            "example": 900
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "expiresIn"
        ]
      },
      "RegisterCompleteRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "code": {
            "type": "string",
            "maxLength": 32
          },
          "username": {
            "type": "string",
            "maxLength": 64
          },
          "displayName": {
            "type": "string",
            "maxLength": 200
          },
          "password": {
            "type": "string",
            "maxLength": 1024
          },
          "timezone": {
            "type": "string",
            "maxLength": 64
          },
          "device": {
            "$ref": "#/components/schemas/Device"
          }
        },
        "required": [
          "email",
          "code",
          "username",
          "displayName",
          "password",
          "device"
        ]
      },
      "Device": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "platform": {
            "type": "string",
            "enum": [
              "android",
              "windows",
              "linux",
              "macos"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "id",
          "platform"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Sistema"
        ],
        "summary": "Comprueba que la API responde",
        "responses": {
          "200": {
            "description": "La API está en marcha",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Paso 1 del registro: envía un código al correo",
        "description": "Responde siempre igual, tenga o no cuenta el correo: si no la tiene, envía el código de registro; si la tiene, envía un aviso de \"ya tienes cuenta\".",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Petición aceptada (idéntica exista o no la cuenta)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Empty"
                }
              }
            }
          },
          "422": {
            "description": "Correo mal formado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Demasiados intentos (cabecera Retry-After)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register/complete": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Paso 2 del registro: crea la cuenta con el código recibido",
        "description": "Comprueba el código antes que cualquier otro dato. Un nombre de usuario ocupado no gasta el código. Reglas: nombre de usuario de 3 a 30 caracteres entre a-z, 0-9 y _ (sin distinguir mayúsculas), nombre visible de 1 a 100 caracteres, contraseña de 10 a 128 caracteres no común, zona horaria IANA (por defecto Europe/Madrid).",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterCompleteRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cuenta creada (ya verificada) y sesión iniciada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "invalid_code: código erróneo, caducado, usado o agotado (siempre igual)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "username_taken, email_taken o device_id_conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Datos no válidos (weak_password, validation_error...)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Demasiados intentos (cabecera Retry-After)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
